# Copie para .env e preencha. Nunca versionar o .env.

# Banco de dados MySQL 8
DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/site_chico

# URLs públicas do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Segredos (gerar valores longos e aleatórios, ex.: openssl rand -base64 32)
NEXTAUTH_SECRET=
CRON_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# PIX
PIX_KEY=

# Melhor Envio (frete)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_CEP=
MELHOR_ENVIO_SANDBOX=true

# E-mail (Resend) - EMAIL_FROM precisa ser de um domínio verificado no Resend
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=
